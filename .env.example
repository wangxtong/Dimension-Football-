# Optional local use: node --env-file=.env.local collector/run.mjs
# Configure at least one fixture provider; two or more enable fixture failover.
# Never commit actual credentials. Deep analysis remains pinned to API-Football.
# football-data.org (preferred when both providers are configured):
FOOTBALL_DATA_API_KEY=
# Alias accepted for the same football-data.org token (KEY takes priority):
FOOTBALL_DATA_API_TOKEN=
# Alternative: API-Football / API-Sports direct subscription (not RapidAPI).
API_FOOTBALL_KEY=
# Sportmonks Football API (fixtures), with Predictions add-on for model probabilities.
SPORTMONKS_API_TOKEN=
# The Odds API: market references; quote credits depend on markets and regions.
THE_ODDS_API_KEY=
# iSports direct subscription: Live Data plus Odds / Odds Pro.
ISPORTS_API_KEY=
# Alternative to the API: a fresh JSON fixture snapshot (see examples/fixtures.json).
FIXTURES_FILE=

# Open-source browser runtime: auto detects dependencies/browser; http disables it;
# crawlee requires it and fails clearly if unavailable.
VANTIS_CRAWLER_ENGINE=auto
# Persistent installation directory from npm run crawler:install -- --runtime ...
VANTIS_CRAWLER_RUNTIME_DIR=
# Optional explicit Chromium path; otherwise detect bundled/system Chromium.
VANTIS_BROWSER_EXECUTABLE=
# Telegram stays disabled until both values are provided. Never commit real values.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
# Authorized Statarea Playwright storageState file, outside source, chmod 600.
VANTIS_STATAREA_STORAGE_STATE=
