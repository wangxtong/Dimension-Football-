# Optional local use: node --env-file=.env.local collector/run.mjs
# Configure at least one provider; configure both for automatic fixture failover.
# Never commit actual credentials. Deep analysis remains pinned to API-Football.
# football-data.org (preferred when both providers are configured):
FOOTBALL_DATA_API_KEY=
# Alias accepted for the same football-data.org token (KEY takes priority):
FOOTBALL_DATA_API_TOKEN=
# Alternative: API-Football / API-Sports direct subscription (not RapidAPI).
API_FOOTBALL_KEY=
# Alternative to the API: a fresh JSON fixture snapshot (see examples/fixtures.json).
FIXTURES_FILE=
