{
  "name": "dimension-football-collection",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "agents:check": "node scripts/agent-team.mjs --check",
    "agents:prompt": "node scripts/agent-team.mjs --role",
    "collect": "node collector/run.mjs",
    "collect:demo": "node collector/run.mjs --demo",
    "fixtures:public": "node collector/public.mjs",
    "collect:public": "node collector/public.mjs --collect",
    "sources:status": "node collector/run.mjs --source-status",
    "providers:status": "node collector/run.mjs --provider-status",
    "sources:activate": "node collector/activate.mjs",
    "crawl:check": "node collector/crawl.mjs",
    "crawler:install": "node scripts/setup-crawler.mjs",
    "crawler:doctor": "node collector/browser.mjs",
    "test:browser": "npm test --prefix collector/browser-runtime",
    "analyze:full": "node collector/analyze.mjs",
    "test": "node --test collector/test/*.test.mjs collector/sources/test/*.test.mjs website/test/*.test.mjs",
    "test:website": "node --test --test-isolation=none website/test/e2e.mjs",
    "site:build": "node website/build.mjs dist",
    "operations:help": "node collector/operations.mjs --help",
    "orchestrate:help": "node collector/orchestrate.mjs --help",
    "check": "node --check collector/run.mjs",
    "audit:sources": "node collector/source-readiness.mjs",
    "audit:markets": "node collector/market-readiness.mjs",
    "audit:model": "node collector/model-readiness.mjs",
    "audit:capacity": "node collector/state-capacity.mjs",
    "collect:observations": "node collector/hosted.mjs --mode observations",
    "audit:control": "node collector/audit-control.mjs",
    "audit:quality": "node collector/evaluation-quality.mjs",
    "export:evaluation": "node collector/export-evaluation.mjs",
    "archive:public:scrapling": "python3 collector/sources/scrapling_archive.py",
    "test:scrapling": "python3 -m unittest discover -s collector/sources/test -p test_scrapling_archive.py -v",
    "research:daily": "node collector/research-daily-report.mjs",
    "research:web:sync": "node collector/publish-research-daily.mjs",
    "cloudflare:build": "node website/build.mjs dist"
  }
}
