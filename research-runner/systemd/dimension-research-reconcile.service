[Unit]
Description=Dimension research restricted UTC event unit reconciliation
After=time-sync.target

[Service]
Type=oneshot
User=root
Group=root
Slice=dimension-research.slice
WorkingDirectory=/opt/dimension-research
Environment=TZ=UTC
ExecStart=/usr/bin/python3 -I -B /opt/dimension-research/runner.py --config /etc/dimension-research/config.json reconcile
TimeoutStartSec=30s
TimeoutStopSec=5s
KillMode=control-group
UMask=0077
Nice=10
CPUWeight=10
MemoryMax=32M
TasksMax=4
LimitNOFILE=64
LimitFSIZE=16M
NoNewPrivileges=yes
CapabilityBoundingSet=CAP_DAC_READ_SEARCH
AmbientCapabilities=CAP_DAC_READ_SEARCH
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
PrivateNetwork=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
RestrictSUIDSGID=yes
RestrictNamespaces=yes
RestrictRealtime=yes
LockPersonality=yes
SystemCallArchitectures=native
RestrictAddressFamilies=AF_UNIX
InaccessiblePaths=-/etc/vantis -/opt/vantis -/var/lib/vantis /etc/dimension-research/api.env
ReadOnlyPaths=/var/lib/dimension-research
ReadWritePaths=/etc/systemd/system
StandardOutput=journal
StandardError=journal
SyslogIdentifier=dimension-research-reconcile
LogRateLimitIntervalSec=60s
LogRateLimitBurst=20
