{
  // Cloudflare Workers 部署配置。构建命令：npm run cloudflare:build
  // 存储用 KV（账号未开通 R2，error 10042）；worker 里的 withKvBucket 会把 KV 包成 R2 形状。
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "dimension-football-research",
  "main": "dist/server/index.js",
  "compatibility_date": "2026-11-03",
  "workers_dev": true,
  "observability": {
    "enabled": true
  },
  "vars": {
    // 两个开关缺一不可：少了 VANTIS_RESEARCH_WEB_ENABLED，/api/research-daily 会返回 RESEARCH_WEB_DISABLED 404。
    "HOSTED_PUBLICATION_ENABLED": "true",
    "VANTIS_RESEARCH_WEB_ENABLED": "true"
  },
  "kv_namespaces": [
    {
      "binding": "RESEARCH_KV",
      "id": "56d2f2123ce24e81acb54a32a031f0dd"
    }
  ]
}
